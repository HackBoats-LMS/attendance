{
  "name": "attendance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "node -e \"const fs=require('fs'),p=require('path');const src=p.join('node_modules','@vladmandic','human','models');const dst=p.join('public','models');if(!fs.existsSync(dst))fs.mkdirSync(dst,{recursive:true});for(const f of['blazeface','facemesh','faceres']){for(const ext of['.json','.bin']){const s=p.join(src,f+ext);if(fs.existsSync(s))fs.copyFileSync(s,p.join(dst,f+ext));}}\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@heroicons/react": "^2.2.0",
    "@prisma/client": "^5.22.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@vladmandic/human": "^3.3.6",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.10",
    "next": "16.3.2",
    "prisma": "^5.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
